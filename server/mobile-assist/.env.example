# Copy to server/mobile-assist/.env if you want this process to read it.
# Never commit the copy. Do not put these values in VITE_ variables.

# Official text and vision API. Leave the key empty to keep local-only mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Vision stays off until you set this to 1. Text mode never sends images.
# Official docs: deepseek-flash accepts images; deepseek-v4-pro does not.
# deepseek-chat, deepseek-reasoner, and retired vision aliases are rejected.
MOBILE_VISION_ENABLED=0

# Optional self-hosted OpenAI-compatible vision endpoint.
# The program does not download or start a model for you.
# MOBILE_VISION_BASE_URL=https://vision.example.com/v1
# MOBILE_VISION_MODEL=your-multimodal-model
# MOBILE_VISION_CONFIRMED=true

# Optional. When set, the phone must send Authorization: Bearer <token>.
# MOBILE_ASSIST_TOKEN=

HOST=127.0.0.1
PORT=8787
